# ============================================
# Gestor de Tareas para Equipos - Backend
# ============================================
# Variables de entorno para el servicio de backend (NestJS)
# Copiar este archivo a .env dentro de la carpeta backend y ajustar valores

# --- Base de Datos PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gestor_tareas

# --- Autenticación JWT ---
# Secreto para firmar tokens JWT (mínimo 32 caracteres)
# AVISO: Cambiar en producción a un valor único y seguro
JWT_SECRET=supersecretkey123456789012345678901234567890

# --- Servidor ---
PORT=3000
