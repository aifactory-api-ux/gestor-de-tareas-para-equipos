# ============================================
# Gestor de Tareas para Equipos - Environment
# ============================================
# Copiar este archivo a .env y ajustar valores si es necesario
# Los valores por defecto funcionan para desarrollo local con Docker

# --- Base de Datos PostgreSQL ---
# Usuario de PostgreSQL
DB_USERNAME=postgres
# Contraseña de PostgreSQL
DB_PASSWORD=postgres
# Nombre de la base de datos
DB_DATABASE=gestor_tareas
# Puerto externo de PostgreSQL (mapeado del contenedor)
DB_PORT=25432

# --- Backend NestJS ---
# Puerto donde corre el backend
BACKEND_PORT=3000
# Secreto para JWT (mínimo 32 caracteres recommended)
# AVISO: Cambiar en producción a un valor único y seguro
JWT_SECRET=supersecretkey123456789012345678901234567890

# --- Frontend React ---
# Puerto externo del frontend (nginx)
FRONTEND_PORT=23002
